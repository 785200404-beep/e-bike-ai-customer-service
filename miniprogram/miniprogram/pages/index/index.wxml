<view class="page">
  <scroll-view class="chat" scroll-y="true" scroll-with-animation="true"
               scroll-into-view="msg-{{messages.length - 1}}">
    <view class="row {{item.role}}" wx:for="{{messages}}" wx:key="index" id="msg-{{index}}">
      <view class="avatar {{item.role}}">{{item.role == 'user' ? '👤' : '🛵'}}</view>
      <view class="body">
        <view class="bubble {{item.role}} {{item.welcome ? 'welcome' : ''}}">{{item.content}}</view>
        <view wx:if="{{item.mapLink}}" class="map-btn"
              data-lat="{{item.mapLink.lat}}" data-lng="{{item.mapLink.lng}}"
              data-name="{{item.mapLink.name}}" data-address="{{item.mapLink.address}}"
              bindtap="onMapTap">🗺️ 导航到店</view>
        <!-- 每条客服回答下的 👍/👎 满意度反馈：点过就换成"已收到反馈" -->
        <view wx:if="{{item.role == 'bot' && !item.welcome && item.question}}" class="fb-row">
          <block wx:if="{{!item.rated}}">
            <view class="fb-btn" data-index="{{index}}" data-rating="1" bindtap="onRate">👍 满意</view>
            <view class="fb-btn" data-index="{{index}}" data-rating="0" bindtap="onRate">👎 不满意</view>
          </block>
          <view wx:else class="fb-done">已收到反馈，谢谢！</view>
        </view>
        <view class="time {{item.role}}">{{item.time}}</view>
      </view>
    </view>
    <view class="row bot" wx:if="{{loading}}">
      <view class="avatar bot">🛵</view>
      <view class="body">
        <view class="bubble bot typing">
          <view class="dot"></view><view class="dot"></view><view class="dot"></view>
        </view>
      </view>
    </view>
  </scroll-view>

  <scroll-view class="chips" scroll-x="true" show-scrollbar="false">
    <view class="chip" wx:for="{{suggestions}}" wx:key="label"
          data-q="{{item.q}}" data-action="{{item.action}}" bindtap="onSuggest">{{item.label}}</view>
  </scroll-view>

  <view class="bar">
    <input class="input" value="{{draft}}" bindinput="onInput" bindconfirm="onSend"
           placeholder="问问价格、库存、续航、竞品对比…" confirm-type="send" />
    <button class="send" bindtap="onSend" disabled="{{loading}}">发送</button>
  </view>

  <!-- 门店信息弹层：南宁一网 13 家，按离客户远近排序，每家可拨号/导航 -->
  <view class="overlay" wx:if="{{showStore}}" bindtap="hideStore">
    <view class="sheet store-sheet" catchtap="noop">
      <view class="sheet-title">🏪 首驱门店 · 南宁一网</view>
      <scroll-view class="store-list" scroll-y="true">
        <view class="store-item" wx:for="{{storeList}}" wx:key="name">
          <view class="store-name">{{item.name}}{{item.dist != null ? ' · 距您 ' + item.dist.toFixed(1) + 'km' : ''}}</view>
          <view class="store-line">📍 {{item.address}}</view>
          <view class="store-line">🕘 {{item.hours || '每天 9:00-21:00，周末不休'}}</view>
          <view class="store-line">📞 {{item.phone}}{{item.contact ? '（店长 ' + item.contact + '）' : ''}}</view>
          <view class="sheet-btns">
            <button class="sheet-btn primary" data-phone="{{item.phone}}" bindtap="callStore">📞 拨打电话</button>
            <button class="sheet-btn" data-lat="{{item.lat}}" data-lng="{{item.lng}}"
                    data-name="{{item.name}}" data-address="{{item.address}}" bindtap="navigateStore">🗺️ 导航</button>
          </view>
        </view>
      </scroll-view>
      <view class="sheet-close" bindtap="hideStore">关闭</view>
    </view>
  </view>

  <!-- 留资弹层 -->
  <view class="overlay" wx:if="{{showLead}}" bindtap="hideLead">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">📱 预约看车 / 留个电话</view>
      <input class="sheet-input" type="number" maxlength="11" placeholder="手机号（我们只用于联系您）"
             value="{{leadPhone}}" bindinput="onLeadPhone" />
      <input class="sheet-input" placeholder="想看的车型（可选）" value="{{leadModel}}" bindinput="onLeadModel" />
      <button class="sheet-btn primary" bindtap="submitLead" disabled="{{leadSaving}}">提交，门店会联系您</button>
      <view class="sheet-close" bindtap="hideLead">取消</view>
    </view>
  </view>
</view>
